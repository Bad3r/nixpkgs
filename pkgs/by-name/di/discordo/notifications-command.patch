+// NotificationCommand returns the notifications.command to run, or nil when it is empty.
+func (cfg *Config) NotificationCommand() (*exec.Cmd, error) {
+	args, err := shellwords.Parse(cfg.Notifications.Command)
+	if err != nil || len(args) == 0 {
+		return nil, err
+	}
+	return exec.Command(args[0], args[1:]...), nil
+}
