+func runNotificationCommand(cfg *config.Config) {
+	cmd, err := cfg.NotificationCommand()
+	if err != nil {
+		slog.Error("failed to parse notification command", "err", err)
+		return
+	}
+	if cmd == nil {
+		return
+	}
+	if err := cmd.Start(); err != nil {
+		slog.Error("failed to start notification command", "err", err)
+		return
+	}
+	go func() {
+		if err := cmd.Wait(); err != nil {
+			slog.Error("notification command failed", "err", err)
+		}
+	}()
+}
