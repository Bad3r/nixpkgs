 #include "ini.h"
 #include "utils.h"
@@ -261,45 +262,89 @@ void add_default_theme(int theme_index) {
         default_themes_index[default_themes_count - 1] = theme_index;
 }
 
+// DirectoryMatchesSize from the icon theme specification, at scale 1
+static bool dir_matches_size(const struct icon_theme_dir *dir, int size) {
+        if (dir->scale != 1)
+                return false;
+        switch (dir->type) {
+                case THEME_DIR_FIXED:
+                        return dir->size == size;
+                case THEME_DIR_SCALABLE:
+                        return dir->min_size <= size && size <= dir->max_size;
+                case THEME_DIR_THRESHOLD:
+                        return dir->size - dir->threshold <= size
+                                && size <= dir->size + dir->threshold;
+        }
+        return false;
+}
+
+// DirectorySizeDistance from the icon theme specification, at scale 1
+static int dir_size_distance(const struct icon_theme_dir *dir, int size) {
+        int min = dir->size, max = dir->size;
+        if (dir->type == THEME_DIR_SCALABLE) {
+                min = dir->min_size;
+                max = dir->max_size;
+        } else if (dir->type == THEME_DIR_THRESHOLD) {
+                min = dir->size - dir->threshold;
+                max = dir->size + dir->threshold;
+        }
+        if (size < min * dir->scale)
+                return min * dir->scale - size;
+        if (size > max * dir->scale)
+                return size - max * dir->scale;
+        return 0;
+}
+
+static char *find_icon_in_dir(const char *name, const struct icon_theme *theme,
+                const struct icon_theme_dir *dir) {
+        const char *suffixes[] = { ".svg", ".svgz", ".png", ".xpm", NULL };
+        for (char **location = theme->locations; *location; location++) {
+                for (const char **suf = suffixes; *suf; suf++) {
+                        char *name_with_extension = g_strconcat(name, *suf, NULL);
+                        char *icon = g_build_filename(*location, theme->subdir_theme,
+                                        dir->name, name_with_extension,
+                                        NULL);
+                        g_free(name_with_extension);
+                        if (is_readable_file(icon))
+                                return icon;
+                        g_free(icon);
+                }
+        }
+        return NULL;
+}
+
