+                char *icon = find_icon_in_dir(name, theme, dir);
+                if (!icon)
                         continue;
-
-                const char *suffixes[] = { ".svg", ".svgz", ".png", ".xpm", NULL };
-                for (char **location = theme->locations; *location; location++) {
-                        for (const char **suf = suffixes; *suf; suf++) {
-                                char *name_with_extension = g_strconcat(name, *suf, NULL);
-                                char *icon = g_build_filename(*location, theme->subdir_theme,
-                                                dir.name, name_with_extension,
-                                                NULL);
