+                        // wins, and the larger one on a tie.
+                        distance = dir_size_distance(dir, size);
+                        if (distance > closest_distance
+                                        || (distance == closest_distance && dir_size <= closest_size))
+                                continue;
                 }
-                if (!match_size)
