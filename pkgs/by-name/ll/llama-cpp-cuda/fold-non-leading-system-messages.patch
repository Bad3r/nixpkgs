+// Qwen3.5 raises on a system message after the first turn; it must be folded into the leading one
+static void test_fold_non_leading_system_messages() {
+    LOG_DBG("%s\n", __func__);
+
+    auto tmpls = read_templates("models/templates/Qwen3.5-4B.jinja");
+    const auto msg = [](const std::string & role, const std::string & content) {
+        common_chat_msg m;
+        m.role    = role;
+        m.content = content;
+        return m;
+    };
+    const auto check = [&](const std::vector<common_chat_msg> & messages, const std::string & expected_system) {
+        common_chat_templates_inputs inputs;
+        inputs.messages              = messages;
+        inputs.add_generation_prompt = true;
+        const std::string prompt     = common_chat_templates_apply(tmpls.get(), inputs).prompt.str();
+        const std::string head       = "<|im_start|>system\n" + expected_system + "<|im_end|>\n<|im_start|>user\n";
+        if (prompt.rfind(head, 0) != 0 || prompt.find("<|im_start|>system", 1) != std::string::npos) {
+            throw std::runtime_error("expected one leading system block, got:\n" + prompt);
+        }
+    };
+
+    check({ msg("user", "Hi"), msg("system", "Env") }, "Env");
+    check({ msg("system", "Base"), msg("user", "Hi"), msg("system", "Env") }, "Base\n\nEnv");
+    auto parts = msg("system", "");
+    parts.content_parts = { { "text", "Env" } };
+    check({ msg("system", "Base"), msg("user", "Hi"), msg("system", ""), parts }, "Base\n\nEnv");
+}
