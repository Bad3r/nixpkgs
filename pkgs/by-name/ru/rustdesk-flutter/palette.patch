diff --git a/flutter/lib/common/palette.dart b/flutter/lib/common/palette.dart
new file mode 100644
index 0000000..7cbbcf6
--- /dev/null
+++ b/flutter/lib/common/palette.dart
@@ -0,0 +1,102 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter/material.dart';
+
+/// Dark-theme colors from the first rustdesk/palette.json found in
+/// $XDG_CONFIG_HOME, then each of $XDG_CONFIG_DIRS. Every key is optional and
+/// holds "#RRGGBB" or "#RRGGBBAA"; a missing key keeps the stock color.
+class Palette {
+  Palette._();
+
+  static const keys = {
+    'accent',
+    'background',
+    'dialog',
+    'surface',
+    'input',
+    'popup',
+    'hover',
+    'border',
+    'foreground',
+    'foregroundMuted',
+  };
+
+  static final Map<String, Color> _colors = _load();
+
+  static Color? get accent => _colors['accent'];
+  // Main panes and the active tab.
+  static Color? get background => _colors['background'];
+  // Dialogs; falls back to background.
+  static Color? get dialog => _colors['dialog'] ?? background;
+  // Side panel, tab bar, cards, and outlined buttons.
+  static Color? get surface => _colors['surface'];
+  // Text fields and dropdown buttons; falls back to surface.
+  static Color? get input => _colors['input'] ?? surface;
+  // Menus, dropdown lists, and popup menus.
+  static Color? get popup => _colors['popup'];
+  static Color? get hover => _colors['hover'];
+  static Color? get border => _colors['border'];
+  static Color? get foreground => _colors['foreground'];
+  static Color? get foregroundMuted => _colors['foregroundMuted'];
+
+  static List<String> _searchDirs() {
+    final env = Platform.environment;
+    final home = env['HOME'];
+    final configHome = env['XDG_CONFIG_HOME'] ??
+        (home == null || home.isEmpty ? null : '$home/.config');
+    final configDirs = env['XDG_CONFIG_DIRS'];
+    return [
+      if (configHome != null && configHome.isNotEmpty) configHome,
+      ...(configDirs == null || configDirs.isEmpty ? '/etc/xdg' : configDirs)
+          .split(':')
+          .where((dir) => dir.isNotEmpty),
+    ];
+  }
+
+  static Map<String, Color> _load() {
+    if (!(Platform.isLinux || Platform.isMacOS || Platform.isWindows)) {
+      return {};
+    }
+    for (final dir in _searchDirs()) {
+      final file = File('$dir/rustdesk/palette.json');
+      if (!file.existsSync()) continue;
+      try {
+        return _parse(jsonDecode(file.readAsStringSync()), file.path);
+      } catch (e) {
+        debugPrint('palette: ignoring ${file.path}: $e');
+        return {};
+      }
+    }
+    return {};
+  }
+
+  static Map<String, Color> _parse(Object? json, String path) {
+    if (json is! Map<String, dynamic>) {
+      throw const FormatException('top level is not an object');
+    }
+    final colors = <String, Color>{};
+    json.forEach((key, value) {
+      if (!keys.contains(key)) {
+        debugPrint('palette: $path: unknown key "$key"');
+        return;
+      }
+      final color = value is String ? _parseHex(value) : null;
+      if (color == null) {
+        debugPrint('palette: $path: "$key" is not #RRGGBB or #RRGGBBAA');
+        return;
+      }
+      colors[key] = color;
+    });
+    return colors;
+  }
+
+  static Color? _parseHex(String value) {
+    final match =
+        RegExp(r'^#([0-9a-fA-F]{6})([0-9a-fA-F]{2})?$').firstMatch(value);
+    if (match == null) return null;
+    final rgb = int.parse(match.group(1)!, radix: 16);
+    final alpha = int.parse(match.group(2) ?? 'ff', radix: 16);
+    return Color((alpha << 24) | rgb);
+  }
+}
